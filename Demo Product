          <div 
            class="absolute rounded-full border-2 ${b.color} transition-smooth cursor-pointer hover:scale-125 flex items-center justify-center group z-10 shadow-lg"
            style="left: ${b.left}%; top: ${b.top}%; width: ${b.size}px; height: ${b.size}px;"
          >
            <div class="absolute bottom-full mb-1 hidden group-hover:flex flex-col items-center z-30 pointer-events-none">
              <span class="px-2 py-1 bg-slate-900 text-[10px] font-bold text-white rounded border border-slate-700 whitespace-nowrap shadow-xl">
                ${b.name} (${b.price}k đ · ${b.rev}B)
              </span>
            </div>
          </div>
        `).join('');
      }

      // Render Top 5 Competitors
      const compBody = document.getElementById('competitor-top5-body');
      compBody.innerHTML = data.compTop5.map(c => `
        <tr class="hover:bg-[#12192c]/60 transition-smooth">
          <td class="px-4 py-3.5 text-center">
            <span class="w-6 h-6 rounded-full bg-slate-800 text-orange-400 border border-orange-500/30 font-bold inline-flex items-center justify-center text-xs">
              ${c.rank}
            </span>
          </td>
          <td class="px-4 py-3.5 font-semibold text-slate-100">${c.name}</td>
          <td class="px-4 py-3.5 font-bold text-white font-mono">${c.price}</td>
          <td class="px-4 py-3.5 ${c.isHigh ? 'text-rose-400 font-bold' : 'text-slate-300 font-semibold'}">${c.discount}</td>
          <td class="px-4 py-3.5 font-bold text-slate-100">${c.sold} hộp</td>
          <td class="px-4 py-3.5 text-slate-300 font-semibold">${c.rev}</td>
          <td class="px-4 py-3.5 text-right font-semibold ${c.isDanger ? 'text-rose-400' : 'text-amber-400'}">
            ${c.threat}
          </td>
        </tr>
      `).join('');

      // Tab 3: Combo Strategy
      document.getElementById('combo-subtext').textContent = data.comboSub;
      document.getElementById('combo-aov-single').textContent = data.aovSingle;
      document.getElementById('combo-aov-combo').textContent = data.aovCombo;
      document.getElementById('combo-aov-growth').textContent = data.aovGrowth;
      document.getElementById('combo-rev-single').textContent = data.revSingle;
      document.getElementById('combo-rev-combo').textContent = data.revCombo;
      document.getElementById('combo-netcash-single').textContent = data.netSingle;
      document.getElementById('combo-netcash-combo').textContent = data.netCombo;
      document.getElementById('combo-kpi-growth').textContent = data.aovGrowth;
      document.getElementById('combo-kpi-revenue').textContent = data.kpiRevenue;

      // Tab 4: Logs
      document.getElementById('logs-active-badge').textContent = data.logCountBadge;
      document.getElementById('sidebar-logs-badge').textContent = data.sidebarLogCount;
      const logsContainer = document.getElementById('logs-container');
      logsContainer.innerHTML = data.logs.map(l => `
        <div class="tech-card p-4 rounded-2xl border ${l.border} flex items-center justify-between">
          <div class="flex items-start gap-3.5">
            <div class="w-8 h-8 rounded-xl ${l.iconBg} flex items-center justify-center font-bold text-sm shrink-0">${l.icon}</div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-slate-200">[${l.tag}]</span>
                <span class="text-[10px] ${l.badgeColor} px-2 py-0.2 rounded font-mono">${l.badge}</span>
              </div>
              <p class="text-slate-200 mt-1 font-medium">${l.title}</p>
              <p class="text-[11px] text-slate-400 mt-1">${l.sub}</p>
            </div>
          </div>
          <span class="text-slate-500 font-mono shrink-0 ml-4">${l.time}</span>
        </div>
      `).join('');

      // Settings
      const setTip = document.getElementById('settings-tipping-point');
      if (setTip) setTip.value = data.tippingPoint;
    }

    function renderScatterPlot(points) {
      const container = document.getElementById('scatter-bubbles-container');
      container.innerHTML = points.map(p => {
        const left = Math.min(92, Math.max(2, ((p.x - 240) / (760 - 240)) * 92));
        const top = Math.min(88, Math.max(10, 88 - ((p.y - 28) / (82 - 28)) * 78));
        const color = p.brand === 'quasure' 
          ? 'bg-[#4f8df7] border-[#93c5fd] shadow-[0_0_15px_rgba(79,141,247,0.5)]' 
          : 'bg-[#f97316] border-[#fdba74] shadow-[0_0_15px_rgba(249,115,22,0.5)]';

        return `
          <div 
            class="absolute rounded-full border-2 ${color} transition-smooth cursor-pointer hover:scale-125 flex items-center justify-center group z-10"
            style="left: ${left}%; top: ${top}%; width: ${p.size}px; height: ${p.size}px;"
          >
            <div class="absolute bottom-full mb-1 hidden group-hover:flex flex-col items-center z-30 pointer-events-none">
              <span class="px-2 py-1 bg-slate-900 text-[10px] font-bold text-white rounded border border-slate-700 whitespace-nowrap shadow-xl">
                ${p.name}: ${p.x}k đ (${p.y}k sp)
              </span>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderBarChart(bars) {
      const container = document.getElementById('bar-chart-container');
      const maxVal = 900;
      container.innerHTML = bars.quasure.map((qVal, i) => {
        const nVal = bars.nestle[i];
        const qH = Math.max(6, (qVal / maxVal) * 100);
        const nH = Math.max(6, (nVal / maxVal) * 100);

        return `
          <div class="flex items-end gap-2 h-full group">
            <div class="w-7 sm:w-9 bg-[#4f8df7] rounded-t-lg transition-smooth relative hover:brightness-110 shadow-[0_0_10px_rgba(79,141,247,0.2)]" style="height: ${qH}%;"></div>
            <div class="w-7 sm:w-9 bg-[#f97316] rounded-t-lg transition-smooth relative hover:brightness-110 shadow-[0_0_10px_rgba(249,115,22,0.2)]" style="height: ${nH}%;"></div>
          </div>
        `;
      }).join('');
    }

    function renderTable(rows) {
      const tbody = document.getElementById('top10-table-body');
      tbody.innerHTML = rows.map(r => {
        const rankCircle = r.rank <= 3
          ? `<span class="w-6 h-6 rounded-full bg-[#3b82f6] text-white font-bold inline-flex items-center justify-center text-xs shadow-sm">${r.rank}</span>`
          : `<span class="w-6 h-6 rounded-full bg-[#182238] text-slate-400 font-semibold inline-flex items-center justify-center text-xs">${r.rank}</span>`;

        const comboBadge = r.isCombo
          ? `<span class="ml-2 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30">
               <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg> COMBO
             </span>`
          : '';

        const discountClass = r.isRed ? 'text-rose-400 font-bold' : 'text-slate-300';
        const trendClass = r.isUp ? 'text-emerald-400' : 'text-rose-400';
        const trendIcon = r.isUp ? '↗' : '↘';

        return `
          <tr class="hover:bg-[#12192c]/60 transition-smooth">
            <td class="px-4 py-3.5 text-center">${rankCircle}</td>
            <td class="px-4 py-3.5 font-semibold text-slate-100 flex items-center">
              ${r.name} ${comboBadge}
            </td>
            <td class="px-4 py-3.5 text-slate-400 font-medium">${r.brand}</td>
            <td class="px-4 py-3.5 font-semibold text-slate-200">${r.price}</td>
            <td class="px-4 py-3.5 ${discountClass}">${r.discount}</td>
            <td class="px-4 py-3.5 font-bold text-slate-100">${r.sold}</td>
            <td class="px-4 py-3.5 text-right font-semibold ${trendClass}">${trendIcon} ${r.trend}</td>
          </tr>
        `;
      }).join('');
    }

    function switchTab(tabId) {
      ['radar', 'competitor', 'combo', 'logs', 'settings'].forEach(id => {
        document.getElementById('view-' + id).classList.add('hidden');
        const btn = document.getElementById('tab-btn-' + id);
        btn.className = 'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-slate-200 hover:bg-[#131b2e] transition-smooth';
      });

      document.getElementById('view-' + tabId).classList.remove('hidden');
      document.getElementById('tab-btn-' + tabId).className = 'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-[#1a243d] text-blue-400 transition-smooth';
    }

    function openModal() {
      const dropdown = document.getElementById('notif-dropdown');
      if (dropdown) dropdown.classList.add('hidden');

      const data = scenarioData[currentScenario];
      if (!data.modal) return;

      document.getElementById('modal-level').textContent = data.modal.level;
      document.getElementById('modal-title').textContent = data.modal.title;
      document.getElementById('modal-icon-box').className = `w-12 h-12 rounded-2xl border flex items-center justify-center text-xl font-bold ${data.modal.iconBox}`;
      document.getElementById('modal-desc').innerHTML = data.modal.desc;

      const container = document.getElementById('modal-actions-container');
      container.innerHTML = data.modal.actions.map(act => `
        <div class="flex items-center gap-3.5 p-3.5 bg-[#12141a] border border-[#2a344d]/80 rounded-xl">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center text-sm font-bold shrink-0 ${act.iconBg}">
            ${act.icon}
          </div>
          <span class="text-xs font-semibold text-slate-200">${act.text}</span>
        </div>
      `).join('');

      const submitBtn = document.getElementById('modal-submit-btn');
      submitBtn.textContent = data.modal.btnText;
      submitBtn.className = `px-5 py-2.5 text-xs font-bold rounded-xl shadow-lg transition-smooth flex items-center gap-1.5 ${data.modal.btnClass}`;

      document.getElementById('action-modal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('action-modal').classList.add('hidden');
    }

    function executeCampaign() {
      closeModal();
      const toast = document.getElementById('toast');
      toast.classList.remove('hidden');
      toast.classList.add('flex');
      setTimeout(() => {
        toast.classList.add('hidden');
        toast.classList.remove('flex');
      }, 4000);
    }

    function refreshDataAnimation() {
      const icon = document.getElementById('refresh-icon');
      icon.classList.add('animate-spin');
      setTimeout(() => {
        icon.classList.remove('animate-spin');
        setScenario(currentScenario);
      }, 500);
    }

    // Khởi chạy mặc định Kịch bản Vàng (shock_inflation)
    setScenario('yellow');
  </script>
</body>
</html>
