            Quét & Cập nhật Daily
          </button>
        </div>

        <!-- ================= KHUNG ĐỐI CHIẾU: THÁNG T-1 (BENCHMARK) vs PHASE T (DAILY SENSING) ================= -->
        <div class="tech-card p-4 rounded-2xl border border-blue-500/30 bg-gradient-to-r from-blue-950/30 via-[#0d1527] to-[#12192e] shadow-lg">
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 pb-3 border-b border-[#1c2742]">
            <div class="flex items-center gap-3">
              <div class="w-7 h-7 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center text-sm font-bold shadow-[0_0_12px_rgba(59,130,246,0.3)]">
                ⚖️
              </div>
              <div>
                <h4 class="text-xs font-bold text-white tracking-wide uppercase">Cơ Sở Đối Chiếu Tham Chiếu (Dual-Timeframe Anchor)</h4>
                <p class="text-[11px] text-slate-400">Ranh giới Tháng T-1 được khóa cố định để hệ thống tự động đánh giá từng nhịp sóng hàng ngày.</p>
              </div>
            </div>
            <div class="flex items-center gap-2 font-mono text-[11px]">
              <span class="px-2.5 py-1 bg-[#101728] border border-[#22304f] text-slate-300 rounded-lg">
                Chu kỳ: <strong class="text-blue-400">Tháng T-1</strong> (Lookback Benchmark)
              </span>
              <span class="text-slate-500">➔</span>
              <span class="px-2.5 py-1 bg-blue-500/10 border border-blue-500/30 text-emerald-400 rounded-lg flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                Daily Run: <strong class="text-white">01:00 AM Hôm nay</strong>
              </span>
            </div>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-3 text-xs">
            <div class="p-2.5 bg-[#080c16]/70 rounded-xl border border-[#1a233a]">
              <div class="flex justify-between items-center text-[10px] text-slate-400">
                <span>Trần Chiết Khấu Nội Bộ (T-1)</span>
                <span class="text-blue-400 font-mono font-bold">L_internal</span>
              </div>
              <p class="text-base font-extrabold text-white mt-1">≤ 20.0%</p>
              <p class="text-[10px] text-emerald-400 mt-0.5">Khóa từ Unit Economics (Bảo vệ Margin)</p>
            </div>

            <div class="p-2.5 bg-[#080c16]/70 rounded-xl border border-[#1a233a]">
              <div class="flex justify-between items-center text-[10px] text-slate-400">
                <span>Ngưỡng Gãy Hành Vi (T-1)</span>
                <span class="text-rose-400 font-mono font-bold">T_behav</span>
              </div>
              <p class="text-base font-extrabold text-rose-400 mt-1" id="anchor-tipping">34.5%</p>
              <p class="text-[10px] text-slate-400 mt-0.5">CART Tree từ 1.693 bản ghi quá khứ</p>
