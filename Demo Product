        <p id="sidebar-status-desc" class="text-[10px] text-slate-500 mt-1">2 cảnh báo hành động đang chờ xử lý.</p>
      </div>

      <div class="flex items-center gap-3 px-2 py-1.5">
        <div class="w-8 h-8 rounded-full bg-blue-600/20 border border-blue-500/40 flex items-center justify-center text-xs font-bold text-blue-400">
          TC
        </div>
        <div class="text-xs">
          <p class="font-bold text-white leading-tight">Bibica Strategy</p>
          <p class="text-[11px] text-slate-400">Executive Pricing Lead</p>
        </div>
      </div>
    </div>
  </aside>

  <!-- ================= MAIN CONTENT ================= -->
  <main class="flex-1 flex flex-col h-screen overflow-y-auto bg-[#080c16] transition-smooth">
    
    <!-- TOP HEADER -->
    <header class="h-16 border-b border-[#1a233a] bg-[#0d1322]/80 backdrop-blur-md px-8 flex items-center justify-between sticky top-0 z-30 shrink-0 transition-smooth">
      <div class="relative flex items-center">
        <input
          type="text"
          placeholder="Tìm SKU Quasure, đối thủ, tín hiệu Daily..."
          class="w-80 bg-[#121829] border border-[#1f2a44] rounded-xl px-3.5 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500 pl-9 pr-8 transition-smooth"
        />
        <svg class="w-3.5 h-3.5 text-slate-500 absolute left-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <span class="absolute right-2.5 px-1.5 py-0.5 text-[9px] bg-[#1a233a] text-slate-400 rounded font-mono">⌘K</span>
      </div>

      <!-- Right Controls -->
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-1 bg-[#121829] p-1 rounded-xl border border-[#1f2a44]">
          <span class="text-[11px] text-slate-400 px-2 font-medium">Pipeline Daily:</span>
          <button onclick="setScenario('green')" id="btn-green" class="px-3 py-1 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-smooth">
            🟢 dbo.product
          </button>
          <button onclick="setScenario('yellow')" id="btn-yellow" class="px-3 py-1 text-xs font-semibold rounded-lg bg-[#b45309]/30 text-amber-400 border border-amber-500/40 transition-smooth">
            🟡 shock_inflation
          </button>
          <button onclick="setScenario('red')" id="btn-red" class="px-3 py-1 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-smooth">
            🔴 shock_price_war
          </button>
        </div>

        <div class="flex items-center gap-3 border-l border-[#1a233a] pl-4 relative">
          <!-- Button Sáng / Tối -->
          <button onclick="toggleTheme()" id="btn-theme-toggle" title="Chuyển đổi giao diện Sáng / Tối" class="text-slate-400 hover:text-amber-400 p-2 rounded-xl hover:bg-[#1a233a] transition-smooth">
            <svg id="theme-icon-sun" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <svg id="theme-icon-moon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          </button>

          <!-- Button Chuông Thông Báo -->
          <div class="relative">
            <button onclick="toggleNotifDropdown()" id="btn-notif" title="Báo cáo tóm tắt chỉ đạo chiến lược" class="text-slate-400 hover:text-white p-2 rounded-xl hover:bg-[#1a233a] relative transition-smooth">
              <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
              <span id="notif-red-dot" class="w-2 h-2 rounded-full bg-rose-500 absolute top-1.5 right-1.5 shadow-[0_0_8px_#f43f5e]"></span>
            </button>

            <!-- DROPDOWN CHỈ ĐẠO CHO SẾP -->
            <div id="notif-dropdown" class="hidden absolute right-0 mt-3 w-[450px] bg-[#101626] border border-[#222f4d] rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.6)] p-5 z-50 text-slate-200 animate-fadeIn">
              <div class="flex items-center justify-between pb-3.5 border-b border-[#1c2742]">
                <div class="flex items-center gap-2.5">
                  <div id="notif-header-dot" class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_8px_#fbbf24] animate-pulse"></div>
                  <span class="font-extrabold text-[13px] text-white tracking-wide uppercase">Chỉ Đạo Tác Chiến Hàng Ngày</span>
                </div>
                <span class="text-[10px] text-slate-400 font-mono" id="notif-timestamp">Hôm nay, 01:15 AM (Đã đối soát)</span>
              </div>

              <div class="py-4 space-y-3.5" id="notif-content-boss"></div>

              <div class="pt-3.5 border-t border-[#1c2742] flex items-center justify-between">
                <span class="text-[11px] text-slate-400 font-medium">Bibica Executive Pipeline</span>
                <button onclick="openModal()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-blue-600/30 transition-smooth flex items-center gap-1.5">
                  <span>⚡</span> Xem Lệnh Phản Công
                </button>
              </div>
            </div>
          </div>

          <!-- User Profile -->
          <div class="w-8 h-8 rounded-full bg-blue-600/20 border border-blue-500/50 flex items-center justify-center text-xs font-bold text-blue-400">TC</div>
          <div class="text-left leading-tight hidden lg:block">
            <p class="text-xs font-bold text-white">Trần Trung</p>
            <p class="text-[10px] text-slate-400">Pricing Project Lead</p>
          </div>
        </div>
      </div>
    </header>

    <!-- CONTENT BODY -->
    <div class="max-w-7xl mx-auto w-full p-8 space-y-7 pb-24">

      <!-- ================= TAB 1: MARKET RADAR ================= -->
      <div id="view-radar" class="space-y-6">
        <div class="flex justify-between items-center">
          <div>
            <div class="flex items-center gap-2.5">
              <h2 class="text-[26px] font-extrabold text-white tracking-tight">Market Radar</h2>
              <span id="title-status-pill" class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-[#b45309]/20 text-amber-400 border border-amber-500/40 flex items-center gap-1.5">
