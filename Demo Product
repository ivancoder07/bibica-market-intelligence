      <nav class="p-3 space-y-1.5 text-[13px] font-semibold">
        <button onclick="switchTab('radar')" id="tab-btn-radar" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-[#1a243d] text-blue-400 transition-smooth">
          <span class="flex items-center gap-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v3m0 12v3m9-9h-3M6 12H3"/></svg>
            Market Radar
