        </div>

        <!-- 4 Metric Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="tech-card p-5 rounded-2xl relative shadow-sm">
            <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center absolute right-4 top-4">
